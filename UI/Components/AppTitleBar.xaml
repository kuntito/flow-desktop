<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="flow_desktop.UI.Components.AppTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:components="using:flow_desktop.UI.Components"
    mc:Ignorable="d">
    
    <UserControl.Resources>
        <Storyboard x:Name="PlaylistNameBlink"
                    RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="ActivePlaylistButton"
                Storyboard.TargetProperty="Opacity"
                From="0.85" To="0.2"
                Duration="0:0:0.7"
                AutoReverse="True"/>
        </Storyboard>
    </UserControl.Resources>


    <Grid Height="64"
          Padding="24,0"
    >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- left row, items order left to right -->
        <StackPanel Grid.Column="0"
            Orientation="Horizontal"
            Spacing="16"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
        >
            <Image Width="48"
                   Height="18"
                   Source="/Assets/flow_logo.png"
                   Visibility="{x:Bind VisibleWhenFalse(IsPlaylistActive), Mode=OneWay}"
            />
            
            <Border x:Name="ActivePlaylistButton"
                    Background="Transparent"
                    Tapped="DeactivatePlaylist"
                    PointerEntered="ShowHandCursor"
                    PointerExited="ShowDefaultCursor"
                    Visibility="{x:Bind IsPlaylistActive, Mode=OneWay}">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Image Source="{x:Bind IconFor(IsActivePlaylistAuto), Mode=OneWay}"
                           Width="24"
                           Height="24"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ActivePlaylistName, Mode=OneWay}"
                               FontSize="18"
                               MaxWidth="200"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTelli}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <components:SearchBar 
            Grid.Column="1"
            dependencyWrapperSongSearchState="{x:Bind SongSearchState, Mode=OneWay }"
            OnSearch="{x:Bind OnSearch}"
            OnPlaySong="{x:Bind OnPlaySong}"
        />

        <!-- right row, items order right to left -->
        <StackPanel Grid.Column="2"
            Orientation="Horizontal"
            Spacing="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FlowDirection="RightToLeft"
        >
            <Button Width="40"
                Height="40"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                FlowDirection="LeftToRight"
                Click="GoToPlaylists"
            >
                <Image Source="ms-appx:///Assets/ic_list.png"
                       Width="24"
                       Height="24"/>
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
