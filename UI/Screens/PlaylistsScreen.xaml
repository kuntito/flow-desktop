<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="flow_desktop.UI.Screens.PlaylistsScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:components="using:flow_desktop.UI.Components"
    xmlns:models="using:flow_desktop.Models"
    mc:Ignorable="d">
    <Grid
        Background="{StaticResource BrushKDB}"
    >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- top bar, same height and padding as the home title bar -->
        <components:TopBarPlaylistsScreen 
            x:Name="TopBar"
            Grid.Row="0"
        />

        <ListView Grid.Row="1"
                  Padding="16,0"
                  ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                  DoubleTapped="OnPlaylistDoubleTapped"
        >
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="8,0,0,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:PlaylistItem">
                    <components:LiPlaylist
                        PlaylistName="{x:Bind Name}"
                    />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1"
                   Text="playlists not available"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{x:Bind ViewModel.IsPlaylistsUnavailable, Mode=OneWay}"/>
    </Grid>
</Page>