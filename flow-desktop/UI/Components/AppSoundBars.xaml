<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="flow_desktop.UI.Components.AppSoundBars"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- each bar runs 300ms up, 300ms down, forever, starting 0, 100, 200ms apart -->
        <Storyboard x:Name="BarsStoryboard">
            <DoubleAnimation Storyboard.TargetName="BarOneScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.3" To="1" Duration="0:0:0.3"
                             AutoReverse="True" RepeatBehavior="Forever"
                             BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="BarTwoScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.3" To="1" Duration="0:0:0.3"
                             AutoReverse="True" RepeatBehavior="Forever"
                             BeginTime="0:0:0.1"/>
            <DoubleAnimation Storyboard.TargetName="BarThreeScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.3" To="1" Duration="0:0:0.3"
                             AutoReverse="True" RepeatBehavior="Forever"
                             BeginTime="0:0:0.2"/>
        </Storyboard>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal"
                Spacing="2"
                Height="14"
                VerticalAlignment="Center"
                >
        <!-- scaled from the bottom, so bars grow upward -->
        <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2"
                   Fill="{x:Bind BarBrush, Mode=OneWay}"
                   RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="BarOneScale" ScaleY="0.3"/>
            </Rectangle.RenderTransform>
        </Rectangle>

        <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2"
                   Fill="{x:Bind BarBrush, Mode=OneWay}"
                   RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="BarTwoScale" ScaleY="0.3"/>
            </Rectangle.RenderTransform>
        </Rectangle>

        <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2"
                   Fill="{x:Bind BarBrush, Mode=OneWay}"
                   RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="BarThreeScale" ScaleY="0.3"/>
            </Rectangle.RenderTransform>
        </Rectangle>
    </StackPanel>
</UserControl>