<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="flow_desktop.UI.Components.PlayNextQueueSLI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:flow_desktop.UI.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        ColumnSpacing="16"
        Height="48"
        VerticalAlignment="Center"
    >
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem
                    Text="remove"
                    Click="Remove"/>
            </MenuFlyout>
        </Grid.ContextFlyout>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <components:AlbumArtSLI
            Grid.Column="0"/>

        <components:SongTitleAndArtistSLI
            Grid.Column="1"
            SongTitle="{x:Bind SongTitle, Mode=OneWay}"
            ArtistStr="{x:Bind ArtistStr, Mode=OneWay}"/>

        <Image
            Grid.Column="2"
            Source="ms-appx:///Assets/ic_drag_handle.png"
            Width="24"
            Height="24"
            Margin="0,0,4,0"/>

    </Grid>
</UserControl>