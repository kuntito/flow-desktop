<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="flow_desktop.UI.Components.LiPlaylist"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:components="using:flow_desktop.UI.Components"
    mc:Ignorable="d">

    <StackPanel Orientation="Horizontal"
                Spacing="16"
                Height="48"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
    >
        <Grid Width="24"
              Height="24"
              VerticalAlignment="Center">
            
            <Image Source="{x:Bind IconFor(IsAuto), Mode=OneWay}"
                   Width="24"
                   Height="24"
                   Visibility="{x:Bind IconVisibility(PlaylistId, ActivePlaylistId), Mode=OneWay}"
            />
            <components:AppSoundBars
                BarBrush="{StaticResource BrushTelli}"
                HorizontalAlignment="Center"
                Visibility="{x:Bind BarsVisibility(PlaylistId, ActivePlaylistId), Mode=OneWay}"
            />
        </Grid>
        
        <TextBlock Text="{x:Bind PlaylistName, Mode=OneWay}"
                   FontSize="18"
                   TextTrimming="CharacterEllipsis"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   Width="220"
        />
        
        <!-- balances the icon's weight, so the name sits centered -->
        <Border Width="24"
                Height="24"
        />
    </StackPanel>
</UserControl>